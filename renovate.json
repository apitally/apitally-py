{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>apitally/renovate-config"],
  "ignoreDeps": ["pytest-asyncio"],
  "packageRules": [
    {
      "description": "Never raise lower bounds of runtime dependencies",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.dependencies", "project.optional-dependencies"],
      "rangeStrategy": "widen",
      "dependencyDashboardApproval": false,
      "automerge": false
    },
    {
      "description": "OpenTelemetry packages pin each other",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.dependencies", "project.optional-dependencies"],
      "matchPackageNames": ["opentelemetry-*"],
      "groupName": "OpenTelemetry"
    },
    {
      "matchPackageNames": ["pytest"],
      "allowedVersions": "<9"
    }
  ]
}
